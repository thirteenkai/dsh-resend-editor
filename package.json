{
  "name": "dsh-resend-editor",
  "version": "0.3.0",
  "description": "DeepSeek Harness 插件：编辑已发出的消息后重发（改文字、删图、拖动排序、补图，第一条也能编辑），@ 引用图片，对话图片可复制／下载／拖进输入框。Edit and resend sent messages, @-reference images, copy/download chat images.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "edit",
    "resend",
    "message"
  ],
  "author": "thirteenkai",
  "license": "MIT",
  "homepage": "https://github.com/thirteenkai/dsh-resend-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirteenkai/dsh-resend-editor.git"
  },
  "bugs": {
    "url": "https://github.com/thirteenkai/dsh-resend-editor/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
